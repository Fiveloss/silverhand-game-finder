# Скопируйте этот файл в .env и заполните. Файл .env никогда не коммитьте:
# в нём секретные ключи. Пустое значение = настройка выключена или берётся по умолчанию.

# ===== Обязательно =====

# Токен бота. Напишите @BotFather в Telegram -> /newbot -> он пришлёт строку
# вида 123456789:AAE... Вставьте её целиком.
BOT_TOKEN=

# Ваш Telegram id (число). Узнать: напишите @userinfobot, он ответит "Id: 123456789".
# Владельцы управляют доступом. Несколько владельцев через запятую: 111,222
OWNER_IDS=

# ===== Кто может пользоваться ботом =====

# Id друзей, которым бот разрешён, через запятую: 333,444
# (каждый узнаёт свой id у @userinfobot). Владелец также может добавлять
# людей прямо в боте командой /allow.
ALLOWED_IDS=

# 1 = бот отвечает всем, кто его найдёт; 0 = только владельцам и ALLOWED_IDS.
# Лучше оставить 0: каждый разбор игры расходует бесплатный дневной лимит нейросети,
# и посторонние люди быстро его выберут (дальше бот до завтра работает на эвристиках).
OPEN_ACCESS=0

# ===== Аналитик отзывов: бесплатные нейросети =====

# Нейросеть читает отзывы игроков и пишет "паспорт" игры, понимает запрос, написанный
# своими словами, и выбирает финальную тройку игр. Оба сервиса ниже бесплатные,
# банковская карта не нужна. Ключи необязательны: без них бот тоже работает, но только
# на простых эвристиках (теги игроков и ключевые слова в отзывах и в запросе), грубее.
# Можно указать один ключ или оба. Бот сначала спрашивает Gemini Flash, если тот упёрся
# в лимит или перегружен - Gemini Flash Lite (тот же ключ), и только потом Groq. Нейросети получают текст запроса,
# публичные отзывы и факты об игре; имя и Telegram id пользователя - нет.
#
# У бесплатных тарифов есть лимиты в минуту и в сутки. Сервис, который упёрся в лимит,
# отдыхает 90 секунд (при повторе 10 минут), а отзывы тем временем читает другой.
# Если отдыхают оба, паспорт строится эвристиками, а игра позже перечитывается.

# ----- Google Gemini (основной) -----
# Как получить ключ:
#   1. Откройте https://aistudio.google.com/apikey и войдите в аккаунт Google.
#   2. Если сайт попросит, примите условия использования.
#   3. Нажмите "Create API key" (Создать ключ). Если спросит проект, создайте новый.
#   4. Скопируйте ключ (начинается с AIza) и вставьте после знака "=".
# Не подключайте в этом проекте оплату (Billing): пока её нет, ключ работает только
#   на бесплатном тарифе и списать деньги не может.
# Лимиты: на моделях Flash примерно несколько сотен запросов в сутки (один запрос -
#   одна игра). Google задаёт лимиты на проект и время от времени меняет их; ваши
#   цифры видны в AI Studio: https://aistudio.google.com/rate-limit
#   Суточный лимит обнуляется в полночь по тихоокеанскому времени (Калифорния).
# На бесплатном тарифе Google может использовать запросы, чтобы улучшать свои продукты.
#   Здесь это не страшно: уходят публичные отзывы (Steam, GOG, Reddit) и текст запроса.
# Gemini доступен не во всех странах (и сайт AI Studio, и запросы с сервера бота).
#   Если ключ получить не вышло, укажите только Groq или оставьте оба поля пустыми.
GEMINI_API_KEY=

# Модель Gemini. gemini-flash-latest - всегда актуальная модель Flash, менять не нужно.
GEMINI_MODEL=gemini-flash-latest

# Запасная модель Gemini с тем же ключом: разбирает отзывы проще, зато её бесплатный
# лимит отдельный и обычно больше. Пустое значение = gemini-flash-lite-latest.
GEMINI_LITE_MODEL=gemini-flash-lite-latest

# Модель эмбеддингов Gemini для поиска по смыслу: бот превращает описание игры и короткие
# фрагменты отзывов в "векторы смысла" и сравнивает их со словами из запроса, а самый
# близкий фрагмент показывает на карточке как цитату игрока. Работает с тем же ключом
# GEMINI_API_KEY, отдельный ключ не нужен; без ключа Gemini поиск по смыслу выключен.
# Лимит у эмбеддингов свой; если он кончился, бот досчитает векторы позже.
# Не меняйте: векторы другой модели несравнимы, и при смене бот сотрёт все посчитанные
# векторы и будет пересчитывать их несколько дней. По умолчанию gemini-embedding-001
# (у gemini-embedding-2 почти нет бесплатного лимита).
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ----- Groq (запасной) -----
# Как получить ключ:
#   1. Откройте https://console.groq.com/keys и войдите (аккаунт Google, GitHub или почта).
#   2. Нажмите "Create API Key" и впишите любое название, например gamefinder.
#   3. Сразу скопируйте ключ (начинается с gsk_): второй раз сайт его не покажет.
# Карта не нужна: бесплатный тариф остаётся бесплатным, пока вы сами не перейдёте
#   на платный.
# Лимиты: у Groq мало токенов (объёма текста) в минуту, поэтому бот отправляет ему
#   меньше отзывов на игру (25 вместо 60). Есть и суточные лимиты. Ваши цифры - в консоли
#   Groq, раздел Settings -> Limits.
GROQ_API_KEY=

# Модель Groq. Менять не нужно.
GROQ_MODEL=llama-3.3-70b-versatile

# Предохранитель: сколько игр в сутки (по UTC) бот отдаёт нейросетям на разбор отзывов.
# Денег это не стоит; лимит нужен, чтобы бот не выбирал бесплатные квоты подчистую.
# Фоновое чтение каталога берёт не больше 80% лимита, остальное ждёт запросов
# пользователей. Понимание запроса и выбор финальной тройки сюда не входят.
# Когда лимит исчерпан, новые игры до завтра разбираются по тегам.
LLM_DAILY_GAMES=400

# ===== Необязательные источники =====

# IGDB (база игр Twitch) - нужна, чтобы игры не из Steam (эксклюзивы Epic, консольные)
# годились как ориентир "как ...". Бесплатно, карта не нужна. Без неё такие игры бот
# описывает через нейросеть (если есть ключ Gemini или Groq).
# Как получить:
#   1. Откройте https://dev.twitch.tv/console/apps и войдите в аккаунт Twitch
#      (если его нет, зарегистрируйтесь; Twitch может попросить включить
#      двухфакторную аутентификацию - без неё приложение не создать).
#   2. Нажмите "Register Your Application".
#   3. Name - любое уникальное название, например gamefinder-igdb.
#      OAuth Redirect URLs - http://localhost (нажмите "Add").
#      Category - Application Integration.
#      Client Type - Confidential.
#   4. Отметьте капчу, если она есть, и нажмите "Create".
#   5. В списке приложений нажмите "Manage" у нового приложения.
#   6. Client ID - скопируйте строку из поля "Client ID" в IGDB_CLIENT_ID.
#   7. Нажмите "New Secret", подтвердите и скопируйте секрет в IGDB_CLIENT_SECRET:
#      второй раз сайт его не покажет (можно создать новый, старый перестанет работать).
# Лимит IGDB: 4 запроса в секунду, бот держится ниже.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Ключ Steam Web API - нужен для графа совместной игры: бот читает открытые библиотеки
# игроков, которые хвалят игру в отзывах, и запоминает только суммы по играм ("кто любит A,
# много играет и в B"), без Steam id и самих библиотек.
# Получить: https://steamcommunity.com/dev/apikey (домен можно указать любой, например localhost).
STEAM_API_KEY=

# Reddit - дополнительный источник отзывов. Получить: https://www.reddit.com/prefs/apps ->
# "create another app" -> тип "script", redirect uri любой (например http://localhost).
# CLIENT_ID - строка под названием приложения, SECRET - поле "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ===== Значения ниже можно не трогать =====

# Регион магазина Steam для каталога и описаний игр (двухбуквенный код: kz, ru, us, de...).
# Цены на карточках бот берёт для региона, который спрашивает у каждого пользователя.
STORE_CC=kz

# 1 = карточки игр слегка анимированы (короткое видео 2 с, нужен ffmpeg, он ставится
# вместе с зависимостями); 0 = только картинки.
ANIMATE_CARDS=1

# Через сколько дней "паспорт" игры (разбор отзывов) считается устаревшим и пересобирается.
PASSPORT_MAX_AGE_DAYS=30

# Размер каталога: CATALOG_PAGES × 400 игр из топа продаж, × 200 из топа по отзывам,
# плюс 200 популярных новинок. Каталог пополняется раз в сутки в фоне.
CATALOG_PAGES=5

# Файл базы данных.
DB_PATH=data/gamefinder.db

# Подробность журнала: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
