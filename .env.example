# Copy this file to .env and fill it in. Never commit .env: it holds secret keys.
# An empty value means the setting is off or takes its default.

# ===== Required =====

# The bot token. Message @BotFather in Telegram -> /newbot -> it sends a line like
# 123456789:AAE... Paste it whole.
BOT_TOKEN=

# Your Telegram id (a number). To find it, message @userinfobot: it replies "Id: 123456789".
# Owners manage access. Several owners, comma-separated: 111,222
OWNER_IDS=

# ===== Who can use the bot =====

# Ids of friends allowed to use the bot, comma-separated: 333,444
# (everyone can get their id from @userinfobot). An owner can also let people in
# right in the bot with /allow.
ALLOWED_IDS=

# 1 = the bot answers anyone who finds it; 0 = only the owners and ALLOWED_IDS.
# Better keep 0: every game breakdown spends the free daily model quota, and strangers
# use it up quickly (after that the bot runs on heuristics until tomorrow).
OPEN_ACCESS=0

# ===== The review analyst: free language models =====

# A model reads player reviews and writes the game's "passport", understands a request
# written in the player's own words, and chooses the final three games. Both services below
# are free and need no bank card. The keys are optional: without them the bot still works,
# but only on simple heuristics (player tags and keywords in reviews and in the request),
# which is rougher. Set one key or both. Each job has its own order: reviews are read by
# Gemini Flash Lite (Flash gives only about 20 free calls a day, so it is kept for choosing
# the final three), quick calls go to Groq first. A Groq key is strongly recommended: it is
# free and answers in 1-2 seconds, which makes picks noticeably faster. The models get the
# request text, public reviews and facts about the game; never the user's name or Telegram id.
#
# Free tiers have per-minute and daily limits. A service that hits a limit rests for
# 90 seconds (10 minutes if it happens again) while the other one reads reviews. If both
# are resting, the passport is built by heuristics and the game is re-read later.

# ----- Google Gemini (main) -----
# How to get a key:
#   1. Open https://aistudio.google.com/apikey and sign in with a Google account.
#   2. Accept the terms of use if the site asks.
#   3. Click "Create API key". If it asks for a project, create a new one.
#   4. Copy the key (it starts with AIza) and paste it after the "=".
# Do not enable billing in this project: without it the key works on the free tier only
#   and cannot charge you anything.
# Limits: a few hundred calls a day on the Flash models (one call = one game). Google sets
#   limits per project and changes them from time to time; yours are in AI Studio:
#   https://aistudio.google.com/rate-limit
#   The daily limit resets at midnight Pacific time.
# On the free tier Google may use the calls to improve its products. Here that's harmless:
#   what goes out is public reviews (Steam, GOG, Reddit) and the request text.
# Gemini isn't available in every country (both the AI Studio site and calls from the bot's
#   server). If you can't get a key, set only Groq or leave both empty.
GEMINI_API_KEY=

# The Gemini model. gemini-flash-latest is always the current Flash model; no need to change it.
GEMINI_MODEL=gemini-flash-latest

# A fallback Gemini model on the same key: it reads reviews more simply, but its free quota
# is separate and usually bigger. Empty = gemini-flash-lite-latest.
GEMINI_LITE_MODEL=gemini-flash-lite-latest

# The Gemini embedding model for meaning-based search: the bot turns game descriptions and
# short review fragments into "meaning vectors", compares them with the words of a request,
# and shows the closest fragment on the card as a player quote. It works with the same
# GEMINI_API_KEY, no separate key; without a Gemini key meaning-based search is off.
# Embeddings have their own limit; when it runs out, the bot finishes the vectors later.
# Don't change it: vectors of another model can't be compared, so on a change the bot drops
# every computed vector and recomputes them for several days. Default gemini-embedding-001
# (gemini-embedding-2 has almost no free quota).
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ----- Groq (fallback) -----
# How to get a key:
#   1. Open https://console.groq.com/keys and sign in (Google, GitHub or email).
#   2. Click "Create API Key" and type any name, e.g. gamefinder.
#   3. Copy the key right away (it starts with gsk_): the site won't show it again.
# No card needed: the free tier stays free until you switch to a paid plan yourself.
# Limits: Groq allows few tokens (amount of text) a minute, so the bot sends it fewer
#   reviews per game (25 instead of 60). There are daily limits too. Yours are in the Groq
#   console, Settings -> Limits.
GROQ_API_KEY=

# The Groq model. No need to change it.
GROQ_MODEL=openai/gpt-oss-120b

# A safety cap: how many games a day (UTC) the bot gives the models for review analysis.
# It costs no money; the cap keeps the bot from using up the free quotas entirely.
# Background catalog reading takes at most 80% of it; the rest waits for players' requests.
# Understanding requests and choosing the final three don't count here.
# When the cap is reached, new games are read from their tags until tomorrow. Gemini Flash
# Lite gives about 500 free calls a day: 500 leaves ~100 of them for players' requests.
LLM_DAILY_GAMES=500

# ===== Optional sources =====

# IGDB (Twitch's game database): lets games outside Steam (Epic exclusives, console games)
# work as a "like ..." reference. Free, no card. Without it the bot describes such games
# through a model (if there is a Gemini or Groq key).
# How to get it:
#   1. Open https://dev.twitch.tv/console/apps and sign in to Twitch
#      (sign up if needed; Twitch may ask you to turn on two-factor authentication,
#      an application can't be created without it).
#   2. Click "Register Your Application".
#   3. Name: any unique name, e.g. gamefinder-igdb.
#      OAuth Redirect URLs: http://localhost (click "Add").
#      Category: Application Integration.
#      Client Type: Confidential.
#   4. Tick the captcha if there is one and click "Create".
#   5. In the list of applications click "Manage" next to the new one.
#   6. Client ID: copy the "Client ID" field into IGDB_CLIENT_ID.
#   7. Click "New Secret", confirm, and copy the secret into IGDB_CLIENT_SECRET:
#      the site won't show it again (you can make a new one; the old one stops working).
# IGDB limit: 4 requests a second; the bot stays below it.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key: needed for the co-play graph. The bot reads the public libraries of
# players who praise a game in reviews and keeps only totals per game ("who loves A plays
# a lot of B"), never Steam ids or the libraries themselves.
# Get one: https://steamcommunity.com/dev/apikey (any domain will do, e.g. localhost).
STEAM_API_KEY=

# Reddit: an extra source of reviews. Get it: https://www.reddit.com/prefs/apps ->
# "create another app" -> type "script", any redirect uri (e.g. http://localhost).
# CLIENT_ID is the string under the app's name, SECRET is the "secret" field.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ===== Fine as they are =====

# The Steam store region for the catalog and game descriptions (a two-letter code: us, de, kz...).
# Prices on the cards come from the region the bot asks each player for.
STORE_CC=kz

# 1 = game cards are slightly animated (a 2-second video; needs ffmpeg, which comes with the
# dependencies); 0 = still pictures only.
ANIMATE_CARDS=1

# After how many days a game's "passport" (its review breakdown) is stale and rebuilt.
PASSPORT_MAX_AGE_DAYS=30

# Catalog size: CATALOG_PAGES × 400 games from the top sellers, × 200 from the top rated,
# plus 200 popular new releases. The catalog is refreshed once a day in the background.
CATALOG_PAGES=10

# The database file.
DB_PATH=data/gamefinder.db

# Log detail: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
